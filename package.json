{
  "name": "inferno-cyber-monday",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "node --test scripts/*.test.mjs",
    "build": "npm run typecheck && vite build && node scripts/check-build.mjs",
    "check": "npm run format && npm run test && npm run build",
    "security:check": "npm audit --audit-level=low"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
